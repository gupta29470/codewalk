# Copy to frontend/.env.local
# Local Next.js UI only — not used on cloud server

NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-side proxy to the Python API (e.g. /api/semantic-search):
API_URL=http://localhost:8000

# Production cloud API (if frontend talks to server):
# NEXT_PUBLIC_API_URL=https://api.codewalk.xyz
# API_URL=https://api.codewalk.xyz
